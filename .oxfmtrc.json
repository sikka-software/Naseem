{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "semi": true,
  "tabWidth": 2,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "sortTailwindcss": {},
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "/node_modules",
    ".contentlayer",
    ".content-collections",
    ".source",
    "/coverage",
    "/.next/",
    "/out/",
    "/build",
    "*.tsbuildinfo",
    ".DS_Store",
    "*.pem",
    "/.pnp",
    ".pnp.js",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    ".env*.local",
    ".vercel",
    "next-env.d.ts",
    "pnpm-lock.yaml",
    "content",
    "public/r"
  ]
}
